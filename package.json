{
  "name": "awalogo",
  "version": "0.1.0",
  "private": true,
  "description": "awalogo — open source Nigerian bank and financial institution logos for Figma and developer projects.",
  "homepage": "https://awalogo.com",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "db:migrate": "node scripts/neon-migrate.mjs",
    "db:smoke": "node scripts/neon-smoke.mjs",
    "db:smoke:staging": "node scripts/neon-staging-smoke.mjs",
    "db:smoke:production": "node scripts/neon-production-smoke.mjs",
    "brands:research": "node scripts/research-brands.mjs",
    "brands:publish": "node scripts/publish-brands.mjs",
    "brands:check": "node scripts/publish-brands.mjs --check && tsx packages/brands/validate.ts && node scripts/brands-baseline.mjs",
    "build": "tsc -p packages/logos/tsconfig.build.json && tsc -p packages/institutions/tsconfig.build.json && pnpm build:web && pnpm build:plugin",
    "build:web": "pnpm --filter @awalogo/web build",
    "build:plugin": "pnpm --filter @awalogo/figma-plugin build",
    "dev:web": "pnpm --filter @awalogo/web dev",
    "dev:plugin": "pnpm --filter @awalogo/figma-plugin dev",
    "test": "vitest run",
    "security:audit": "node scripts/dependency-audit.mjs",
    "typecheck": "tsc -b",
    "validate": "tsx packages/validator/src/validate.ts && pnpm institutions:validate",
    "institutions:generate": "tsx packages/institutions/scripts/generate.ts",
    "institutions:import:fintech-list": "tsx packages/institutions/scripts/import-fintech-list.ts",
    "logos:prepare:fintech-sourcing": "tsx packages/logos/scripts/build-fintech-sourcing-manifest.ts",
    "logos:import:fintech-discovery": "tsx packages/logos/scripts/import-fintech-discovery-logos.ts",
    "institutions:refresh": "tsx packages/institutions/scripts/refresh.ts",
    "institutions:validate": "tsx packages/institutions/scripts/validate.ts",
    "institutions:check": "tsx packages/institutions/scripts/generate.ts --check",
    "logos:formats": "tsx packages/logos/scripts/generate-formats.ts",
    "logos:check-formats": "tsx packages/logos/scripts/generate-formats.ts --check",
    "vercel:check-functions": "node scripts/check-vercel-functions.mjs",
    "logos:source": "tsx packages/logos/scripts/source-logos.ts",
    "logos:discover:web": "tsx packages/logos/scripts/discover-web-logos.ts",
    "logos:discover:fintech": "tsx packages/logos/scripts/discover-web-logos.ts --manifest packages/logos/sourcing/fintech-340-manifest.json",
    "logos:discover:variations": "tsx packages/logos/scripts/discover-logo-variations.ts",
    "logos:stage:variations": "tsx packages/logos/scripts/stage-logo-variations.ts && pnpm logos:formats",
    "logos:stage:web": "tsx packages/logos/scripts/stage-web-discoveries.ts",
    "logos:stage:fintech": "tsx packages/logos/scripts/stage-fintech-sourcing.ts",
    "logos:source:fintech-unverified": "tsx packages/logos/scripts/source-unverified-fintech-logos.ts",
    "logos:source:nigeria-logos": "tsx packages/logos/scripts/source-nigeria-logos.ts",
    "logos:import:nigerialogos": "tsx packages/logos/scripts/import-nigerialogos.ts",
    "logos:import:finance-apps": "tsx packages/logos/scripts/import-finance-apps.ts",
    "logos:import:coverage": "tsx packages/logos/scripts/import-institution-coverage.ts",
    "logos:import:naicom": "tsx packages/logos/scripts/import-naicom-directory-logos.ts",
    "logos:sync-links": "tsx packages/logos/scripts/sync-institution-logo-links.ts",
    "logos:promote": "tsx packages/logos/scripts/promote-candidates.ts && pnpm logos:sync-links && pnpm institutions:generate && pnpm logos:formats",
    "catalog:generate": "tsx packages/logos/scripts/generate-runtime-catalog.ts",
    "catalog:check": "tsx packages/logos/scripts/generate-runtime-catalog.ts --check"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "cheerio": "^1.2.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "sax": "1.6.1",
    "@neon/config": "1.10.0",
    "@neon/env": "1.6.6",
    "@vercel/functions": "3.10.4",
    "pg": "8.23.1"
  }
}
