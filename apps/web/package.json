    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "fflate": "0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
