# GitHub OAuth app used only to identify maintainers.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# A comma-separated, case-insensitive list of approved GitHub usernames.
ADMIN_GITHUB_LOGINS=

# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Optional dedicated AES-256 key for encrypted request metadata. Keep stable across deployments.
# Falls back to ADMIN_SESSION_SECRET when omitted. Generate with: openssl rand -base64 48
LOGO_REQUEST_STORAGE_SECRET=

# Fine-grained token with Contents, Pull requests, and Issues read/write access to this repo.
GITHUB_ADMIN_TOKEN=
GITHUB_REPOSITORY=adeyemimayokun/awalogo
GITHUB_DEFAULT_BRANCH=main

# Private logo-request delivery. Verify awalogo.com in Resend before using the example sender.
RESEND_API_KEY=
LOGO_REQUEST_FROM_EMAIL=awalogo <requests@awalogo.com>
LOGO_REQUEST_INBOX=

# Canonical deployed origin, without a trailing slash.
PUBLIC_SITE_URL=

# Optional. Disabled by default so privacy tools do not produce analytics load warnings.
VITE_ENABLE_VERCEL_ANALYTICS=false
VITE_ENABLE_VERCEL_SPEED_INSIGHTS=false
