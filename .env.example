# GitHub OAuth app used only to identify maintainers.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# A comma-separated, case-insensitive list of approved GitHub usernames.
ADMIN_GITHUB_LOGINS=

# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Optional dedicated AES-256 key for encrypted request metadata. Keep stable across deployments.
# Falls back to ADMIN_SESSION_SECRET when omitted. Generate with: openssl rand -base64 48
LOGO_REQUEST_STORAGE_SECRET=

# Required for public logo requests in deployed environments (including Preview).
# Stable server-only HMAC secret, at least 32 characters. Generate: openssl rand -base64 48
LOGO_REQUEST_ABUSE_SECRET=

# Fine-grained token with Contents, Pull requests, and Issues read/write access to this repo.
GITHUB_ADMIN_TOKEN=
GITHUB_REPOSITORY=adeyemimayokun/awalogo
GITHUB_DEFAULT_BRANCH=main

# Private logo-request delivery. Verify awalogo.com in Resend before using the example sender.
RESEND_API_KEY=
LOGO_REQUEST_FROM_EMAIL=awalogo <requests@awalogo.com>
LOGO_REQUEST_INBOX=

# Neon server-only database access. Pulled by neon deploy; never prefix with VITE_.
# DATABASE_URL selects Neon; deployed public logo requests require Neon and migration 002.
# Legacy Supabase fallback is not a distributed public request abuse guard.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Stable random secret for daily anonymous download deduplication.
DOWNLOAD_HASH_SECRET=
# Staging only: save requests/reports without sending email or creating real issues.
# Ignored in production even when true.
DISABLE_PREVIEW_DELIVERY=false

# Legacy database fallback, used only when DATABASE_URL is absent.
SUPABASE_URL=https://btrehjfxhqfwfpxrdyhl.supabase.co
SUPABASE_SECRET_KEY=

# Canonical deployed origin, without a trailing slash.
PUBLIC_SITE_URL=

# Website visits: set true only for a production release after enabling Web Analytics in Vercel.
# Preview/local hosts and private routes are excluded even if this flag is true.
VITE_ENABLE_VERCEL_ANALYTICS=false
# Separate performance monitoring; not required for visit tracking.
VITE_ENABLE_VERCEL_SPEED_INSIGHTS=false
# Enable automatic first-visit feature tour only with the approved V2 production launch.
VITE_V2_LIVE=false

# Admin-only Vercel Web Analytics API credentials. Never use VITE_ prefixes here.
ADMIN_ANALYTICS_VERCEL_TOKEN=
ADMIN_ANALYTICS_PROJECT_ID=
ADMIN_ANALYTICS_TEAM_ID=
# Product event collection requires BOTH flags, a production deployment and production origin.
# Keep false in Preview/staging; production activation is a separate release action.
VITE_ENABLE_PRODUCT_ANALYTICS=false
ENABLE_PRODUCT_ANALYTICS=false
