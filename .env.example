# GitHub OAuth app used only to identify maintainers.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# A comma-separated, case-insensitive list of approved GitHub usernames.
ADMIN_GITHUB_LOGINS=

# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Fine-grained token with Contents, Pull requests, and Issues read/write access to this repo.
GITHUB_ADMIN_TOKEN=
GITHUB_REPOSITORY=adeyemimayokun/awalogo
GITHUB_DEFAULT_BRANCH=main

# Transactional request and submission emails. Verify awalogo.com in Resend before using the example sender.
RESEND_API_KEY=
# Full-access Resend key used only for private notification contacts and segments.
RESEND_AUDIENCE_API_KEY=
LOGO_REQUEST_FROM_EMAIL=awalogo <requests@awalogo.com>
LOGO_REQUEST_INBOX=

# Canonical deployed origin, without a trailing slash.
PUBLIC_SITE_URL=

# Generate with: openssl rand -hex 32
CRON_SECRET=
